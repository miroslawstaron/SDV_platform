      },
      "title": "Faults",
      "type": "array"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "title": "Assertions",
      "type": "array"
    }
  },
  "title": "RunRequest",
  "type": "object"
}