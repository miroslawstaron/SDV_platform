          "maximum": 6,
          "title": "Max Accel",
          "type": "number"
        },
        "normal_decel": {
          "default": 3,
          "exclusiveMinimum": 0,
          "maximum": 6,
          "title": "Normal Decel",
          "type": "number"
        },
        "emergency_decel": {
          "default": 6,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Emergency Decel",
          "type": "number"
        },
        "max_speed": {
          "default": 36.11111111111111,
          "exclusiveMinimum": 0,
          "maximum": 55,
          "title": "Max Speed",
          "type": "number"
        }
      },
      "title": "Vehicle",
      "type": "object"
    }
  },
  "properties": {
    "route_id": {
      "default": "carla-city",
      "title": "Route Id",
      "type": "string"
    },
    "carla": {
      "$ref": "#/$defs/CarlaRendering"
    },
    "scenario_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "scenario": {
      "anyOf": [
        {
