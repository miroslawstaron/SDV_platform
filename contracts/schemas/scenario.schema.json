          "default": null,
          "title": "Value"
        },
        "delay_ms": {
          "default": 300,
          "maximum": 5000,
          "minimum": 0,
          "title": "Delay Ms",
          "type": "number"
        }
      },
      "required": [
        "module",
        "kind"
      ],
      "title": "Fault",
      "type": "object"
    },
