{
  "$defs": {
    "Assertion": {
      "properties": {
        "kind": {
          "enum": [
            "arrived",
            "max_speed",
            "min_charge",
            "stopped",
            "no_recorder_loss"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "CarlaRendering": {
      "properties": {
        "graphics": {
          "default": "high",
          "enum": [
            "low",
            "high"
          ],
          "title": "Graphics",
          "type": "string"
        },
        "resolution": {
          "default": "1080p",
          "enum": [
            "720p",
            "1080p"
          ],
          "title": "Resolution",
          "type": "string"
        }
      },
      "title": "CarlaRendering",
      "type": "object"
    },
    "DrivingScenario": {
      "properties": {
        "id": {
          "maxLength": 64,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/DrivingScenarioSettings"
        },
        "unrecognized": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Unrecognized",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "prompt",
        "settings"
      ],
      "title": "DrivingScenario",
      "type": "object"
    },
    "DrivingScenarioSettings": {
      "properties": {
        "pedestrians": {
          "default": 48,
          "maximum": 100,
          "minimum": 0,
          "title": "Pedestrians",
          "type": "integer"
        },
        "traffic_vehicles": {
          "default": 8,
          "maximum": 40,
          "minimum": 0,
          "title": "Traffic Vehicles",
          "type": "integer"
        },
        "speed_kmh": {
          "default": 25,
          "maximum": 80,
          "minimum": 5,
          "title": "Speed Kmh",
          "type": "number"
        },
        "distance_m": {
          "default": 500,
          "maximum": 2000,
          "minimum": 100,
          "title": "Distance M",
          "type": "number"
        },
        "duration_seconds": {
          "default": 180,
          "maximum": 900,
          "minimum": 1,
          "title": "Duration Seconds",
          "type": "number"
        },
        "seed": {
          "default": 42,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
