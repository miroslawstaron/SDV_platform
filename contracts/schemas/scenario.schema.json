        "type": "object"
      },
      "title": "Modules",
      "type": "object"
    },
    "duration": {
      "default": 900,
      "exclusiveMinimum": 0,
      "maximum": 900,
      "title": "Duration",
      "type": "number"
    },
    "faults": {
      "items": {
