MAPILLARY_ACCESS_TOKEN=
SIMULATOR_BACKEND=carla
CARLA_RUNTIME=windows
# Empty uses host.docker.internal for native Windows CARLA.
CARLA_HOST=
CARLA_PORT=2000
CARLA_RENDERER=nvidia
CARLA_CAMERA_WIDTH=1920
CARLA_CAMERA_HEIGHT=1080
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
CONTROLLER_COMMAND=python3 -m sdv.application
# Set to 0.0.0.0 to access the dashboard through this machine's network address.
SDV_WEB_BIND=127.0.0.1
